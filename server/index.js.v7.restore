// ─── POST /api/upload-parkour ─────────────────────────────────────────────────
app.post('/api/upload-parkour', uploadParkour.single('trackImage'), handleMulterError, (req, res) => {
    if (!req.file) {
        return res.status(400).json({ success: false, error: 'No file uploaded' });
