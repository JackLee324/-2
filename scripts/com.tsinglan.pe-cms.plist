<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      com.tsinglan.pe-cms — 开机自启 / 崩溃自动重启

      安装：
        pkill -f "node server/index.js" || true
        chmod +x ~/Developer/cms/scripts/start-server.sh
        cp ~/Developer/cms/scripts/com.tsinglan.pe-cms.plist ~/Library/LaunchAgents/
        launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.tsinglan.pe-cms.plist

      查看状态 / 日志：
        launchctl list | grep pe-cms
        tail -f ~/Developer/cms/logs/server.out

      卸载：
        launchctl bootout gui/$(id -u) ~/Library/LaunchAgents/com.tsinglan.pe-cms.plist
        rm ~/Library/LaunchAgents/com.tsinglan.pe-cms.plist

      注意：本文件根元素之外不能有任何内容（包括注释），否则 launchd 会报
      "Load failed: 5: Input/output error"。注释只能放在 <dict> 内部。
    -->

    <key>Label</key>
    <string>com.tsinglan.pe-cms</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/jacklee/Developer/cms/scripts/start-server.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jacklee/Developer/cms</string>

    <!-- 开机自启 + 进程退出后自动拉起 -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- 崩溃后重启的节流：最短 10 秒一次，避免疯狂重启刷日志 -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/jacklee/Developer/cms/logs/server.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/jacklee/Developer/cms/logs/server.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>NODE_ENV</key>
        <string>production</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
